# ----------------------------
# STAGE 1: Build
# ----------------------------
FROM node:current-alpine AS builder
ARG BUILD_VERSION=0.0.0
ARG BUILD_NUMBER=0
ARG BUILD_DATE
ARG GIT_COMMIT
RUN apk update && apk upgrade --no-cache
WORKDIR /app

COPY code/package*.json ./
RUN npm install

COPY code ./

# Version skew protection (Next.js `deploymentId`): every build gets its own
# ID, so after the container is upgraded, a browser tab still open on the old
# version does a full reload on its next request instead of calling server
# actions that no longer exist ("Server Action unavailable"). Read at build
# time and embedded in the output. BUILD_NUMBER is unique per build.sh run.
# Next.js only accepts letters, digits, "-" and "_" in it, so anything else
# (the dots in "1.0.0") becomes "_": 1.0.0 + 1793280397 -> 1_0_0-1793280397.
RUN NEXT_DEPLOYMENT_ID="$(printf '%s-%s' "${BUILD_VERSION}" "${BUILD_NUMBER}" | tr -c 'A-Za-z0-9_-' '_')" \
    npm run build

RUN npx drizzle-kit generate

# ----------------------------
# STAGE 2: Runtime
# ----------------------------
FROM node:current-alpine

ARG BUILD_VERSION=0.0.0
ARG BUILD_NUMBER=0
ARG BUILD_DATE
ARG GIT_COMMIT

LABEL com.buckup-hub.image.version="${BUILD_VERSION}" \
      com.buckup-hub.image.created="${BUILD_DATE}" \
      com.buckup-hub.image.revision="${GIT_COMMIT}" \
      build.number="${BUILD_NUMBER}"

WORKDIR /app

# Dump tools for each engine: mariadb-dump (MySQL/MariaDB), pg_dump/psql
# (PostgreSQL) and mongodump/mongorestore (MongoDB, from Alpine's community
# repository). Only the two MongoDB tools Backup Hub uses are kept, which
# saves ~70 MB.
RUN apk update && apk upgrade --no-cache && \
    apk add --no-cache mariadb-client mariadb-connector-c postgresql-client mongodb-tools && \
    cd /usr/bin && rm -f bsondump mongoexport mongofiles mongoimport mongostat mongotop && \
    mongodump --version && mongorestore --version

ENV NEXT_TELEMETRY_DISABLED=1

# Copy standalone build
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
COPY --from=builder /app/db ./db

# Copy generated migrations
COPY --from=builder /app/db/migrations ./db/migrations

# Install ws dependencies
COPY --from=builder /app/package.json ./package.json
WORKDIR /app/ws
# this adds around 300MB to the image
RUN npm install --production --omit=dev --ignore-scripts

WORKDIR /app

COPY docker/entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh && sed -i 's/\r$//' ./entrypoint.sh

RUN echo "VERSION=${BUILD_VERSION}" > /app/version.txt && \
    echo "BUILD_NUMBER=${BUILD_NUMBER}" >> /app/version.txt && \
    echo "BUILD_DATE=${BUILD_DATE}" >> /app/version.txt && \
    echo "GIT_COMMIT=${GIT_COMMIT}" >> /app/version.txt

EXPOSE 3000
CMD ["./entrypoint.sh"]