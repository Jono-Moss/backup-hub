# --- Backup Hub's own database (stores users, tasks, run history, API keys) ---
# This is separate from the databases you configure Backup Hub to back up.
#
# If you're running via `npm run dev` / `npm start` directly (not Docker),
# set this to wherever your MySQL server actually is. If you're running via
# `docker compose up`, this value is ignored — compose builds the URL itself
# from the MYSQL_* variables below, so app and db can never disagree.
APP_DATABASE_URL="mysql://user:password@localhost:3306/backup_hub"

# --- Used only by docker-compose.yml, to provision the bundled MySQL container ---
# Required if you're using `docker compose up`. Ignored otherwise.
BH_DATABASE_ROOT_PASSWORD="replace-with-a-long-random-secret"
BH_DATABASE_NAME="backup_hub"
BH_DATABASE_USER="backup_hub"
BH_DATABASE_PASSWORD="replace-with-a-long-random-secret"
BH_DATABASE_HOST="backup-hub-db"

# --- Master key used to encrypt stored DB credentials and backup passwords at rest ---
# Generate with: openssl rand -hex 32
BH_BACKUP_MASTER_KEY="replace-with-a-long-random-secret"

# --- Where backup files are written on disk ---
BACKUP_DIR="/var/backups/backup-hub"

# --- Outbound email for notifications (task success/failure, logins, user/task changes) ---
# Leave unset to disable notifications entirely (backups still run fine without it).
BH_SMTP_HOST=""
BH_SMTP_PORT="587"
BH_SMTP_SECURE="false"
BH_SMTP_USER=""
BH_SMTP_PASS=""
BH_SMTP_FROM="Backup Hub <backup-hub@yourdomain.com>"

# --- Optional: pin specific dump binaries ---
# Only needed if the default (whatever's first on PATH) isn't right — e.g.
# multiple MySQL/Postgres client versions installed locally, or you hit the
# mysqldump 9.3+/server version-mismatch issue described in the README.
# MYSQLDUMP_PATH="/opt/homebrew/opt/mysql-client@8.4/bin/mysqldump"
# PG_DUMP_PATH="/opt/homebrew/opt/postgresql@16/bin/pg_dump"
# PG_ISREADY_PATH="/opt/homebrew/opt/postgresql@16/bin/pg_isready"

# --- Passkeys (WebAuthn) ---
# WEBAUTHN_RP_ID must be exactly the domain the app is served from, with no
# scheme and no port (e.g. "backup.yourdomain.com", or "localhost" for local
# dev — that's the default if unset). A passkey registered under one RP ID
# will not show up as an option under a different one, so changing this
# after people have registered passkeys breaks their existing passkeys.
# WEBAUTHN_ORIGIN must be the exact scheme+host(+port) the browser sees.
# WebAuthn refuses to run at all over plain HTTP except on localhost, so in
# production both of these need a real HTTPS origin.
BH_WEBAUTHN_RP_NAME="Backup Hub"
BH_WEBAUTHN_RP_ID="localhost"
BH_WEBAUTHN_ORIGIN="http://localhost:3000"

# --- Public address of this app ---
# Used to build the links in "forgot password" emails. Set it to the exact
# address people open Backup Hub at (e.g. "https://backup.yourdomain.com").
# Defaults to BH_WEBAUTHN_ORIGIN if unset. Password reset emails also need the
# SMTP settings above; without them, the "Forgot password?" page tells users
# to ask an admin instead.
BH_APP_URL="http://localhost:3000"

# --- Test restores (optional) ---
# Every backup is automatically checked to read back completely. Set these to
# also allow test restores: the backup is restored into a brand-new throwaway
# database (named bh_verify_...) on this server, checked, then dropped again.
# Use a SEPARATE scratch server, never production — a test restore puts real
# load on it. The account needs permission to create and drop databases.
# Leave unset to hide the "Test restore" option for that engine.
#   MySQL/MariaDB: mysql://user:password@host:3306          (add ?ssl=true to require TLS)
#   PostgreSQL:    postgres://user:password@host:5432/postgres  (the path is the database to connect to for CREATE/DROP DATABASE; add ?sslmode=require for TLS)
#   MongoDB:       mongodb://user:password@host:27017           (add ?tls=true for TLS; ?authSource=<db> if the user isn't defined in "admin")
#                  The user needs to create and drop databases (e.g. the "root" role, or readWriteAnyDatabase + dbAdminAnyDatabase).
# Special characters in the password must be URL-encoded (e.g. @ as %40).
# BH_VERIFY_MYSQL_URL="mysql://verify:change-me@scratch-mysql:3306"
# BH_VERIFY_POSTGRES_URL="postgres://verify:change-me@scratch-postgres:5432/postgres"
# BH_VERIFY_MONGODB_URL="mongodb://verify:change-me@scratch-mongo:27017"

# --- Sign-in lockouts ---
# After BH_LOGIN_MAX_FAILED_ATTEMPTS failed password or 2FA attempts for one
# account within BH_LOGIN_LOCKOUT_MINUTES, that account can't sign in with a
# password until BH_LOGIN_LOCKOUT_MINUTES after the last failure. Retrying
# while locked doesn't extend it, passkeys still work, and an admin can
# unlock the account early from its page under Users. A low limit makes it
# easy for anyone who knows an email address to lock that user out for a
# while — raise it if that's a concern.
# BH_LOGIN_MAX_FAILED_ATTEMPTS_PER_IP separately limits failures of any kind
# (all accounts) from one IP address. IPs come from X-Forwarded-For, so this
# only works behind a reverse proxy that sets it.
# Set either limit to 0 to turn that lockout off.
BH_LOGIN_MAX_FAILED_ATTEMPTS="2"
BH_LOGIN_MAX_FAILED_ATTEMPTS_PER_IP="20"
BH_LOGIN_LOCKOUT_MINUTES="15"
